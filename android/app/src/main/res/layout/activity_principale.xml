<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond">

    <WebView
        android:id="@+id/vue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Montre au commercant ce qui se passe tant que l'hote n'est pas joint.
         Le client, lui, ne voit normalement jamais cet ecran. -->
    <LinearLayout
        android:id="@+id/attente"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/marque"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/message_attente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/texte"
            android:textSize="19sp" />

        <Button
            android:id="@+id/bouton_reessayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/reessayer" />
    </LinearLayout>
</FrameLayout>
